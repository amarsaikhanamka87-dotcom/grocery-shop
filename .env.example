# Copy to .env.local and fill in. Never commit real values.

# Clerk — dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Day 2: Clerk webhook signing secret (Webhooks → endpoint → Signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase — Project settings → Database / API
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Wire.mn (test mode while building)
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=

# n8n — webhook URL + shared secret sent in a header
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Public site URL (Netlify), used for webhooks/callbacks
APP_URL=

# Phone login (our own SMS codes, since Clerk can't text +976)
# OTP_SECRET: random 32+ chars, e.g. `openssl rand -hex 32`
OTP_SECRET=
# Mongolian SMS provider HTTP API (see src/lib/sms.ts). Empty in dev = code printed in the terminal.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
# Supabase direct connection for migrations (pooler URL goes in DATABASE_URL)
DIRECT_URL=
CRON_SECRET=
