generator client {
  provider      = "prisma-client-js"
  // native = your Mac (dev); rhel-openssl-3.0.x = Netlify Functions (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  UNPAID // Төлөгдөөгүй
  PAID // Төлөгдсөн
}

enum OrderStatus {
  PENDING // Хүлээгдэж буй
  CONFIRMED // Баталгаажсан
  DELIVERING // Хүргэлтэнд гарсан
  DELIVERED // Хүргэгдсэн
  CANCELLED // Цуцлагдсан
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  companyName  String? // Байгууллагын нэр
  companyRegNo String? // Байгууллагын регистр
  approved     Boolean  @default(false) // Админ баталгаажуулсан эсэх
  passwordHash String
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String
  price              Int // төгрөгөөр
  oldPrice           Int?
  unit               String // жишээ: "1 кг", "500 гр"
  image              String
  stock              Int                 @default(0)
  minQty             Int                 @default(1) // хамгийн бага захиалах тоо
  isFeatured         Boolean             @default(false)
  isOrganic          Boolean             @default(false)
  origin             String? // фермийн нэр / аймаг
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]
  standingOrderItems StandingOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([categoryId])
}

model Order {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  companyName   String?
  companyRegNo  String?
  phone         String
  district      String
  address       String
  note          String?
  deliverySlot  String
  paymentMethod String        @default("QPAY")
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  qpayInvoiceId String?       @unique
  qpayQrImage   String? // base64 PNG
  qpayShortUrl  String?
  qpayUrls      Json? // банкны аппын холбоосууд
  subtotal      Int
  deliveryFee   Int
  total         Int
  status        OrderStatus   @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  image     String
  unit      String
  price     Int
  quantity  Int

  @@index([orderId])
}

/// One-time SMS sign-in codes for our own phone login (Clerk can't send SMS to +976).
/// Only an HMAC of the code is stored. Used once (consumedAt), expires after a few minutes.
model PhoneOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String // E.164, e.g. +97699112233
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt], map: "phone_otps_phone_created_idx")
  @@map("phone_otps")
}

/// B2B (бизнес) хэрэглэгчийн хүсэлтийн төлөв
enum BusinessStatus {
  PENDING // Хүлээгдэж буй
  APPROVED // Зөвшөөрсөн
  REJECTED // Татгалзсан
}

/// A buyer's request to become a B2B customer (free delivery). The admin approves it,
/// which also sets Clerk publicMetadata.role = "b2b". One application per Clerk user.
model BusinessApplication {
  id           String         @id @default(cuid())
  clerkUserId  String         @unique @map("clerk_user_id")
  companyName  String         @map("company_name")
  companyRegNo String         @map("company_reg_no")
  contactName  String         @map("contact_name")
  phone        String
  address      String?
  status       BusinessStatus @default(PENDING)
  rejectReason String?        @map("reject_reason")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("business_applications")
}

/// A B2B customer's monthly order list ("сар бүрийн захиалга"): which products, how much, and the
/// day of the month to deliver. Auto-placing the order on that day comes with orders (Day 6–8).
model StandingOrder {
  id          String              @id @default(cuid())
  clerkUserId String              @unique @map("clerk_user_id")
  dayOfMonth  Int                 @map("day_of_month") // 1–28 so every month has it
  active      Boolean             @default(true)
  items       StandingOrderItem[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("standing_orders")
}

model StandingOrderItem {
  id              String        @id @default(cuid())
  standingOrderId String        @map("standing_order_id")
  standingOrder   StandingOrder @relation(fields: [standingOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int

  @@unique([standingOrderId, productId])
  @@map("standing_order_items")
}
